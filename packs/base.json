      "id": "user-offline.tools",
      "phase": "user-offline",
      "kind": "tools",
      "title": "Tools, PATH and $PROFILE",
      "why": "Copies Sysinternals and Android platform-tools from the USB to C:\\Tools, puts them on PATH, and adds a small PowerShell profile.",
