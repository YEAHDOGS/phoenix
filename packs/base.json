    {
      "id": "admin-post.playbook",
      "phase": "admin-post",
      "kind": "manual",
      "title": "Run Dogs Playbook in AME Wizard",
      "why": "The playbook strips what the answer file cannot. AME Wizard needs Defender off, which is why Defender comes back on in the next step.",
      "risk": "safe",
      "enabled": true,
      "instructions": "1. Unplug the Windows 11 USB. Keep the Phoenix USB in.\n2. Click **Launch** to open AME Wizard with the Dogs Playbook.\n3. In the playbook options choose **Enable Defender** if offered; leave *Check GPU tensor unlock support* off unless you want the report.\n4. Let it finish and reboot, then log on as the admin again and come back here.",
      "launch": {
        "loadout": "ame-wizard",
        "args": [
          "{loadout:dogs-playbook}"
        ]
      }
    },
    {
      "id": "admin-post.defender",
      "phase": "admin-post",
      "kind": "defender",
      "title": "Defender back on + ASR rules",
      "why": "Turns real-time protection back on after the playbook, loads offline signatures from the USB, and applies every Attack Surface Reduction rule in Block mode.",
      "risk": "safe",
      "enabled": true,
      "realtime": true,
      "asr": "Block",
      "asrExclude": [
        "01443614-cd74-433a-b99e-2ecdc07bfc25"
      ],
      "signaturesFrom": "usb",
      "notes": "Rule 01443614-cd74-433a-b99e-2ecdc07bfc25 (block executables unless they meet prevalence/age/trusted-list criteria) is excluded: it blocks fresh Chocolatey installers. Set it to Audit by hand after apps are installed if you want it."
    },
