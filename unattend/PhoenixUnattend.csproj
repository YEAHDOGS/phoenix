<Project Sdk="Microsoft.NET.Sdk">

  <!--
    phoenix-unattend: a reflection-driven CLI over the vendored Schneegans
    unattend-generator (third_party/unattend-generator, MIT). The vendored
    library is multi-targeted (net8/9/10); referencing it from a net10.0 app
    builds only its net10.0 target, so nothing in third_party is edited.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>phoenix-unattend</AssemblyName>
    <RootNamespace>Phoenix.Unattend</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.0.0</Version>
    <!-- Reflection over the library's types: never trim. -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\third_party\unattend-generator\UnattendGenerator.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="phoenix-defaults.json" LogicalName="phoenix-defaults.json" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

</Project>
