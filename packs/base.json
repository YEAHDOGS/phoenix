      "items": [
        {
          "key": "sysinternals",
          "loadout": "sysinternals",
          "dest": "C:\\Tools\\Sysinternals",
          "why": "Autoruns, Process Explorer, TCPView and friends."
        },
        {
          "key": "platform-tools",
          "loadout": "platform-tools",
          "dest": "C:\\Tools\\platform-tools",
          "why": "adb and fastboot for Android work."
        },
        {
          "key": "path-sysinternals",
          "env": "PATH+",
          "value": "C:\\Tools\\Sysinternals",
          "why": "Run Sysinternals tools from any shell."
        },
        {
          "key": "path-platform-tools",
          "env": "PATH+",
          "value": "C:\\Tools\\platform-tools",
          "why": "Run adb from any shell."
        },
        {
          "key": "profile-phoenix",
          "profileSnippet": "# --- Phoenix ---\nSet-Alias -Name which -Value Get-Command\nfunction phx { & \"$env:ProgramData\\Phoenix\\kit\\engine\\phoenix.ps1\" @args }\nfunction create-app { param([Parameter(Mandatory)][string]$Name) New-Item -ItemType Directory -Path (Join-Path $HOME \"Projects\\$Name\") -Force | Set-Location }\n# --- /Phoenix ---",
          "why": "Small, readable profile: which, phx (engine), create-app."
        }
      ]
