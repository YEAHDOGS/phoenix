{
  "id": "base",
  "name": "Base",
  "version": 1,
  "description": "What every Phoenix machine gets: safe settings, obvious bloat, telemetry services and tasks, policy keys, firewall logging. Declares every step in run order; tiers add to it.",
  "steps": [
    {
      "id": "admin.settings",
      "phase": "admin",
      "kind": "setting",
      "title": "System settings",
      "why": "Machine-wide settings from the gameplan: no hibernation file, no fast startup, no remote assistance, strict UAC, a trusted time server, and privacy toggles.",
      "risk": "safe",
      "enabled": true,
      "items": [
        {
          "setting": "hibernate",
          "value": "off",
          "why": "hiberfil.sys is a full RAM image on disk: a forensic gift. Also frees disk space.",
          "risk": "safe"
        },
        {
          "setting": "fast-startup",
          "value": "off",
          "why": "Fast startup is hibernation of the kernel session; it also keeps BitLocker keys and driver state across \"shutdowns\".",
          "risk": "safe"
        },
        {
          "setting": "remote-assistance",
          "value": "off",
          "why": "Nobody should be able to offer help into this machine.",
          "risk": "safe"
        },
        {
          "setting": "remote-desktop",
          "value": "off",
          "why": "No inbound RDP on a personal laptop.",
          "risk": "safe"
        },
        {
          "setting": "uac",
          "value": "always-notify",
          "why": "Every elevation prompts, including Windows settings changes. Least privilege.",
          "risk": "safe"
        },
        {
          "setting": "time-server",
          "value": "time.cloudflare.com",
          "why": "Use a time source you chose instead of time.windows.com.",
          "risk": "safe"
        },
        {
          "setting": "llmnr",
          "value": "off",
          "why": "LLMNR answers name queries from anyone on the LAN; classic credential-relay vector.",
          "risk": "safe"
        },
        {
          "setting": "activity-history",
          "value": "off",
          "why": "Stops the Timeline/activity feed from recording what you open.",
          "risk": "safe"
        },
        {
          "setting": "search-web",
          "value": "off",
          "why": "Start menu search stays local: no Bing, no web suggestions.",
          "risk": "safe"
        },
        {
          "setting": "cross-device-share",
          "value": "off",
          "why": "\"Share across devices\" off: no Connected Devices Platform pairing.",
          "risk": "safe"
        },
        {
          "setting": "game-dvr",
          "value": "off",
          "why": "Game DVR records in the background and hooks every fullscreen app.",
          "risk": "safe"
        },
        {
          "setting": "task-history",
          "value": "on",
          "why": "Turns on Task Scheduler history so you can see what runs and when.",
          "risk": "safe"
        }
      ]
    },
    {
