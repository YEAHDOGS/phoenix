{
  "id": "tier-lockdown",
  "name": "Tier: Lockdown",
  "description": "Maximum: balanced plus SMB client/server, printing, search indexer, Bluetooth and biometrics off, Core Networking only. Danger items are listed but off; turn them on only if you know why.",
  "version": 1,
  "steps": [
    {
      "id": "admin.services",
      "items": [
        {
          "name": "XblAuthManager",
          "startup": "Disabled",
          "stop": true,
          "why": "Xbox Live auth.",
          "risk": "safe"
        },
        {
          "name": "XblGameSave",
          "startup": "Disabled",
          "stop": true,
          "why": "Xbox cloud saves.",
          "risk": "safe"
        },
