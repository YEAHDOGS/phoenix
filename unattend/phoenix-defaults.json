{
  "$comment": "Phoenix default answer-file DTO, merged over the library's Configuration.Default. Derived from the Schneegans regen URL the hand-built Phoenix template was made from (see unattend/README.md for the mapping). Accounts, computer name, time zone, edition, disk and locales are placeholders: the engine replaces them from phoenix.config.json.",
  "LanguageSettings": {
    "$type": "UnattendedLanguageSettings",
    "ImageLanguage": "en-US",
    "LocaleAndKeyboard": { "Locale": "en-001", "Keyboard": "00000409" },
    "LocaleAndKeyboard2": null,
    "LocaleAndKeyboard3": null,
    "GeoLocation": "244"
  },
  "ProcessorArchitectures": ["amd64"],
  "BypassNetworkCheck": true,
  "ComputerNameSettings": { "$type": "CustomComputerNameSettings", "Name": "PHOENIX-PC" },
  "TimeZoneSettings": { "$type": "ExplicitTimeZoneSettings", "TimeZone": "Central Standard Time" },
  "PESettings": {
    "$type": "GeneratePESettings",
    "PartitionSettings": {
      "$type": "UnattendedPartitionSettings",
      "TargetDiskSettings": { "$type": "FixedTargetDiskSettings", "Index": 0 },
      "PartitionLayout": "GPT",
      "RecoveryMode": "Partition",
      "SystemSize": 100,
      "RecoverySize": 600
    },
    "InstallFromSettings": { "$type": "NameInstallFromSettings", "Name": "Windows 11 Pro" },
    "PagingFileSettings": { "$type": "NoPagingFileSettings" },
    "DisableDefender": false,
    "Disable8Dot3Names": true,
    "PauseBeforeFormatting": false,
    "PauseBeforeReboot": false,
    "CompactOs": false,
    "SkipIntegrityCheck": false
  },
  "ActivationKey": null,
  "AccountSettings": {
    "$type": "UnattendedAccountSettings",
    "Accounts": [
      { "Name": "BigMan", "DisplayName": "", "Password": "", "Group": "Administrators" },
      { "Name": "Main", "DisplayName": "", "Password": "", "Group": "Users" }
    ],
    "AutoLogonSettings": { "$type": "OwnAutoLogonSettings" },
    "ObscurePasswords": true
  },
  "PasswordExpirationSettings": { "$type": "UnlimitedPasswordExpirationSettings" },
  "LockoutSettings": { "$type": "DefaultLockoutSettings" },
  "HideFiles": "None",
  "ShowFileExtensions": true,
  "LaunchToThisPC": true,
  "ShowEndTask": true,
  "TaskbarSearch": "Box",
  "TaskbarIcons": { "$type": "EmptyTaskbarIcons" },
  "HideTaskViewButton": true,
  "DisableBingResults": true,
  "StartTilesSettings": { "$type": "DefaultStartTilesSettings" },
  "StartPinsSettings": {
    "$type": "CustomStartPinsSettings",
    "Json": "{\n  \"pinnedList\": [\n    {\n      \"desktopAppLink\": \"%ALLUSERSPROFILE%\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Microsoft Edge.lnk\"\n    },\n    {\n      \"desktopAppLink\": \"%APPDATA%\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\File Explorer.lnk\"\n    },\n    {\n      \"packagedAppId\": \"windows.immersivecontrolpanel_cw5n1h2txyewy!microsoft.windows.immersivecontrolpanel\"\n    }\n  ]\n}"
  },
  "DisableWindowsUpdate": true,
  "DisableFastStartup": true,
  "HardenSystemDriveAcl": true,
  "DeleteJunctions": true,
  "AllowPowerShellScripts": true,
  "PreventAutomaticReboot": true,
  "DisableAppSuggestions": true,
  "HideEdgeFre": true,
  "DisableEdgeStartupBoost": true,
  "MakeEdgeUninstallable": true,
  "DeleteWindowsOld": true,
  "DisableAutomaticRestartSignOn": true,
  "DisableWpbt": true,
  "ProcessAuditSettings": { "$type": "EnabledProcessAuditSettings", "IncludeCommandLine": true },
  "Effects": { "$type": "DefaultEffects" },
  "DesktopIcons": { "$type": "DefaultDesktopIconSettings" },
  "StartFolderSettings": {
    "$type": "CustomStartFolderSettings",
    "Settings": { "Downloads": true, "Network": true, "Settings": true }
  },
  "WifiSettings": { "$type": "SkipWifiSettings" },
  "ExpressSettings": "DisableAll",
  "LockKeySettings": { "$type": "SkipLockKeySettings" },
  "StickyKeysSettings": { "$type": "DisabledStickyKeysSettings" },
  "ColorSettings": { "$type": "DefaultColorSettings" },
  "WallpaperSettings": { "$type": "DefaultWallpaperSettings" },
  "LockScreenSettings": { "$type": "DefaultLockScreenSettings" },
  "AppLockerSettings": { "$type": "SkipAppLockerSettings" },
  "KeepSensitiveFiles": false,
  "Bloatwares": [
    "Remove3DViewer", "RemoveBingSearch", "RemoveClock", "RemoveCopilot", "RemoveCortana", "RemoveDevHome",
    "RemoveFamily", "RemoveFeedbackHub", "RemoveGameAssist", "RemoveGetHelp", "RemoveHandwriting",
    "RemoveInternetExplorer", "RemoveMaps", "RemoveMathInputPanel", "RemoveMixedReality", "RemoveNotepadClassic",
    "RemoveOffice365", "RemoveOneDrive", "RemoveOneNote", "RemoveOneSync", "RemoveOpenSSHClient", "RemoveOutlook",
    "RemovePaint3D", "RemovePeople", "RemovePowerAutomate", "RemovePowerShell2", "RemovePowerShellISE",
    "RemoveQuickAssist", "RemoveRecall", "RemoveRdpClient", "RemoveSkype", "RemoveSolitaire", "RemoveSpeech",
    "RemoveStepsRecorder", "RemoveTeams", "RemoveGetStarted", "RemoveToDo", "RemoveVoiceRecorder", "RemoveWallet",
    "RemoveWeather", "RemoveWindowsMediaPlayer", "RemoveWindowsTerminal", "RemoveXboxApps"
  ]
}
