    {
      "id": "admin.registry",
      "phase": "admin",
      "kind": "registry",
      "title": "Registry hardening",
      "why": "Policy and default-user keys. default-user scope seeds every profile created later (the lead user is created after this phase, so it inherits them).",
      "risk": "safe",
      "enabled": true,
      "items": [
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "type": "DWord",
          "value": 0,
          "scope": "machine",
          "why": "Telemetry policy: Security level (0).",
          "risk": "safe"
        },
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
          "name": "DisableWindowsConsumerFeatures",
          "type": "DWord",
          "value": 1,
          "scope": "machine",
          "why": "No sponsored app installs.",
          "risk": "safe"
        },
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo",
          "name": "DisabledByGroupPolicy",
          "type": "DWord",
          "value": 1,
          "scope": "machine",
          "why": "No advertising ID.",
          "risk": "safe"
        },
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "DisableAIDataAnalysis",
          "type": "DWord",
          "value": 1,
          "scope": "machine",
          "why": "Recall snapshots off by policy.",
          "risk": "safe"
        },
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
          "name": "TurnOffWindowsCopilot",
          "type": "DWord",
          "value": 1,
          "scope": "machine",
          "why": "Copilot off by policy.",
          "risk": "safe"
        },
        {
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer",
          "name": "DisableSearchBoxSuggestions",
          "type": "DWord",
          "value": 1,
          "scope": "machine",
          "why": "Gameplan: no web suggestions in the search box (machine policy).",
          "risk": "safe"
        },
        {
          "path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\Explorer",
          "name": "DisableSearchBoxSuggestions",
          "type": "DWord",
          "value": 1,
          "scope": "default-user",
          "why": "Gameplan: same, per-user policy.",
          "risk": "safe"
        },
        {
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
          "name": "BingSearchEnabled",
          "type": "DWord",
          "value": 0,
          "scope": "default-user",
          "why": "Gameplan: no Bing in Start.",
