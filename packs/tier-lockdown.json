        {
          "name": "RasAuto",
          "startup": "Disabled",
          "stop": true,
          "why": "Remote Access Auto Connection Manager.",
          "risk": "safe"
        },
        {
          "name": "RasMan",
          "startup": "Disabled",
          "stop": true,
          "why": "Remote Access Connection Manager. Breaks built-in VPN/dial-up (WireGuard/Tailscale are unaffected).",
          "risk": "caution"
        },
        {
          "name": "SstpSvc",
          "startup": "Disabled",
          "stop": true,
          "why": "Secure Socket Tunneling Protocol. Gameplan culprit: it re-creates the WAN Miniport (SSTP).",
          "risk": "caution"
        },
        {
          "name": "SessionEnv",
          "startup": "Disabled",
          "stop": true,
          "why": "Remote Desktop Configuration.",
          "risk": "safe"
        },
        {
          "name": "TermService",
          "startup": "Disabled",
          "stop": true,
          "why": "Remote Desktop Services.",
          "risk": "safe"
        },
        {
          "name": "UmRdpService",
          "startup": "Disabled",
          "stop": true,
          "why": "Remote Desktop UserMode Port Redirector.",
          "risk": "safe"
        },
        {
          "name": "SgrmBroker",
          "startup": "Disabled",
          "stop": true,
