        {
          "name": "vmicvss",
          "startup": "Disabled",
          "stop": true,
          "why": "Hyper-V Volume Shadow Copy Requestor.",
          "risk": "safe"
        },
        {
          "name": "HvHost",
          "startup": "Disabled",
          "stop": true,
          "why": "HV Host Service. Breaks WSL2 / Hyper-V if you use them.",
          "risk": "caution"
        },
        {
          "name": "LanmanWorkstation",
          "startup": "Disabled",
          "stop": true,
          "why": "Workstation (SMB client). Breaks mapped drives, network shares and some apps that expect it.",
          "risk": "caution"
        },
        {
          "name": "LanmanServer",
          "startup": "Disabled",
          "stop": true,
          "why": "Server (SMB file sharing).",
          "risk": "caution"
        },
        {
          "name": "BITS",
          "startup": "Disabled",
          "stop": true,
          "why": "Background Intelligent Transfer. Breaks Store and some updaters.",
          "risk": "caution"
        },
        {
          "name": "Spooler",
          "startup": "Disabled",
          "stop": true,
          "why": "Print Spooler (PrintNightmare). Breaks printing.",
          "risk": "caution"
        },
        {
          "name": "WSearch",
          "startup": "Disabled",
          "stop": true,
          "why": "Windows Search indexer. Start search still works, slower.",
          "risk": "caution"
        },
        {
          "name": "lfsvc",
          "startup": "Disabled",
          "stop": true,
          "why": "Geolocation.",
          "risk": "caution"
        },
        {
          "name": "iphlpsvc",
          "startup": "Disabled",
          "stop": true,
          "why": "IP Helper (IPv6 transition tunnels).",
          "risk": "safe"
        },
        {
          "name": "WbioSrvc",
          "startup": "Disabled",
          "stop": true,
          "why": "Windows Biometric. Breaks Windows Hello face/fingerprint.",
          "risk": "caution"
        },
        {
          "name": "bthserv",
          "startup": "Disabled",
          "stop": true,
          "why": "Bluetooth Support. Breaks Bluetooth.",
          "risk": "caution"
        },
        {
          "name": "BrokerInfrastructure",
          "startup": "Disabled",
          "stop": true,
          "why": "DANGER: Background Tasks Infrastructure. Windows needs it: disabling it breaks Start, Settings and Store apps and can cause boot loops. Listed only so nobody adds it by accident. The gameplan says to kill it in Autoruns; do not.",
          "risk": "danger",
          "enabled": false
        },
        {
          "name": "RpcSs",
          "startup": "Disabled",
          "stop": true,
          "why": "DANGER: Remote Procedure Call. Windows will not boot without it.",
          "risk": "danger",
          "enabled": false
        },
        {
          "name": "DcomLaunch",
          "startup": "Disabled",
          "stop": true,
          "why": "DANGER: DCOM Server Process Launcher. Windows will not boot without it.",
          "risk": "danger",
          "enabled": false
        }
      ]
