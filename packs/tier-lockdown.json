    {
      "id": "admin.settings",
      "items": [
        {
          "setting": "pagefile",
          "value": "off",
          "why": "Gameplan gospel: no paging file, so RAM never touches the disk (forensics). Needs enough RAM: 16 GB+ recommended.",
          "risk": "caution"
        },
        {
          "setting": "crash-dump",
          "value": "off",
          "why": "Crash dumps write RAM to disk too; off for the same reason.",
          "risk": "caution"
        },
        {
          "setting": "device-install-from-wu",
          "value": "off",
          "why": "System Properties > Hardware > Device Installation Settings: No. Windows Update must not push drivers.",
          "risk": "caution"
        },
        {
          "setting": "netbios",
          "value": "off",
          "why": "NetBIOS over TCP/IP off on every adapter (NBT-NS poisoning).",
          "risk": "safe"
        },
        {
          "setting": "network-throttling",
          "value": "off",
          "why": "Gameplan: NetworkThrottlingIndex = ffffffff.",
          "risk": "safe"
        }
      ]
    },
    {
      "id": "admin.tasks",
      "items": [
        {
          "path": "\\Microsoft\\Windows\\Defrag\\ScheduledDefrag",
          "action": "disable",
          "why": "Gameplan: off. Note this task also runs SSD TRIM; run \"Optimize-Volume C -ReTrim\" by hand now and then.",
          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\Registry\\RegIdleBackup",
          "action": "disable",
          "why": "Registry idle backup.",
          "risk": "safe"
        },
        {
          "path": "\\Microsoft\\Windows\\MemoryDiagnostic\\ProcessMemoryDiagnosticEvents",
          "action": "disable",
          "why": "Memory diagnostic telemetry.",
          "risk": "safe"
        },
        {
          "path": "\\Microsoft\\Windows\\MemoryDiagnostic\\RunFullMemoryDiagnostic",
          "action": "disable",
          "why": "Memory diagnostic telemetry.",
          "risk": "safe"
        },
        {
          "path": "\\Microsoft\\Windows\\ExploitGuard\\ExploitGuard MDM policy Refresh",
          "action": "disable",
