          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\UpdateOrchestrator\\Schedule Scan",
          "action": "disable",
          "why": "Update scan wake timer. Some UpdateOrchestrator tasks are protected; those are skipped.",
          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\UpdateOrchestrator\\Schedule Scan Static Task",
          "action": "disable",
          "why": "Update scan wake timer.",
          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\UpdateOrchestrator\\Reboot_AC",
          "action": "disable",
          "why": "Update reboot wake timer.",
          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\UpdateOrchestrator\\Reboot_Battery",
          "action": "disable",
          "why": "Update reboot wake timer.",
          "risk": "caution"
        },
        {
          "path": "\\Microsoft\\Windows\\Flighting\\FeatureConfig\\*",
          "action": "disable",
          "why": "Feature flighting (A/B experiments).",
          "risk": "safe"
        },
        {
          "path": "\\Microsoft\\Windows\\CloudExperienceHost\\CreateObjectTask",
          "action": "disable",
