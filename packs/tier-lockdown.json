    {
      "id": "admin.devices",
      "items": [
        {
          "key": "wan-miniport",
          "match": {
            "friendlyName": "WAN Miniport*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Gameplan: kill WAN Miniports (dial-up/VPN plumbing). SstpSvc/RasMan disabled above stop them coming back.",
          "risk": "caution"
        },
        {
          "key": "ndis-virtual-enum",
          "match": {
            "friendlyName": "NDIS Virtual Network Adapter Enumerator"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Gameplan: System > NDIS Virtual Network Adapter Enumerator.",
          "risk": "caution"
        },
        {
          "key": "rdp-redirector-bus",
          "match": {
            "friendlyName": "Remote Desktop Device Redirector Bus"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Gameplan: \"Remote Management Redirector Bus\". RDP device redirection.",
          "risk": "safe"
        },
        {
          "key": "wifi-direct",
          "match": {
            "friendlyName": "Microsoft Wi-Fi Direct Virtual Adapter*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Wi-Fi Direct virtual adapter. Breaks Mobile Hotspot and Miracast.",
          "risk": "caution"
        },
        {
          "key": "bt-pan",
          "match": {
            "friendlyName": "Bluetooth Device (Personal Area Network)*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Gameplan: delete Bluetooth LAN.",
          "risk": "safe"
        },
        {
          "key": "bt-rfcomm-tdi",
          "match": {
            "friendlyName": "Bluetooth Device (RFCOMM Protocol TDI)*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Bluetooth RFCOMM network transport.",
          "risk": "safe"
        },
        {
          "key": "teredo",
          "match": {
            "friendlyName": "Microsoft Teredo Tunneling Adapter"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "IPv6-over-UDP tunnel through NAT.",
          "risk": "safe"
        },
        {
          "key": "6to4",
          "match": {
            "friendlyName": "Microsoft 6to4 Adapter*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "IPv6 transition tunnel.",
          "risk": "safe"
        },
        {
          "key": "isatap",
          "match": {
            "friendlyName": "Microsoft ISATAP Adapter*"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "IPv6 transition tunnel.",
          "risk": "safe"
        },
        {
          "key": "hyperv-infra",
          "match": {
            "friendlyName": "Microsoft Hyper-V Virtualization Infrastructure Driver"
          },
          "action": "remove",
          "includeHidden": true,
          "why": "Gameplan (crossed out, unsure): breaks WSL2, Hyper-V, and virtualization-based security.",
          "risk": "caution"
        },
        {
          "key": "smbios",
          "match": {
            "friendlyName": "Microsoft System Management BIOS Driver"
          },
          "action": "disable",
          "includeHidden": true,
          "why": "DANGER: breaks WMI hardware queries (Phoenix scans, HP tools, many installers). Gameplan lists it; not recommended.",
          "risk": "danger",
          "enabled": false
        },
        {
          "key": "pic",
          "match": {
            "friendlyName": "Programmable interrupt controller"
          },
          "action": "disable",
          "includeHidden": true,
          "why": "DANGER: can leave the machine unable to boot. Never needed. Listed so nobody adds it by accident.",
          "risk": "danger",
          "enabled": false
        }
      ]
    },
    {
      "id": "admin.firewall",
      "defaultOutbound": "Block",
      "disableOtherRules": true,
      "keepGroups": [
        "Core Networking"
      ],
      "title": "Firewall lockdown (Core Networking only)",
      "why": "Lockdown: only Core Networking (DHCP, DNS, ICMP basics). No mDNS, no network discovery.",
      "risk": "caution"
    },
    {
      "id": "admin.network",
      "enabled": true
    },
